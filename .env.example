# Database & Redis
DATABASE_URL=postgresql://kyc:kyc@localhost:5432/touristkyc
REDIS_URL=redis://localhost:6379

# Server
PORT=3001
JWT_SECRET=replace_me_with_a_long_random_string

# Provider outbound API (placeholder / mock provider)
PROVIDER_BASE_URL=https://provider.example.com/api
PROVIDER_API_KEY=replace_me
PROVIDER_ASSIGN_ENDPOINT=/sim/assign
PROVIDER_TIMEOUT_MS=10000
PROVIDER_MAX_RETRIES=5

# Inbound API key (used by booths / provider calling us, incl. EMRG middleware)
# ⚠️ SECURITY: rotate this value before sharing it with EMRG or any external
# party — any key that has appeared in chat logs, screenshots, or session
# transcripts must be treated as compromised. Since this deployment is
# plain HTTP (no TLS, no domain — see PUBLIC_BASE_URL below), this key
# travels unencrypted on the wire. As a compensating control, restrict
# /api/v1/resources/* at the firewall/network layer to EMRG's specific
# outbound IP range once they provide it — don't rely on the key alone.
INBOUND_API_KEY=replace_me

# Business rules
RESERVATION_DEFAULT_HOLD_SECONDS=120
VISA_SUSPEND_LEAD_HOURS=24
DEREGISTER_STALE_DAYS=14

# Storage: local or supabase
STORAGE_PROVIDER=local
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=replace_me
SUPABASE_BUCKET=subscriber-documents

# Google OAuth — DISABLED for this deployment (plain HTTP, no domain; Google
# requires HTTPS on non-localhost origins). Code is commented out in
# authService.ts / routes/auth.ts / frontend Login.tsx. Do not re-enable
# without TLS + a real domain in place. Left here for reference only.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
ALLOWED_EMAIL_DOMAINS=hamiltel.com

# Production networking (VM behind Nginx reverse proxy)
# FRONTEND_URL: exact origin of the deployed frontend, used for CORS.
# Leave unset if frontend and backend are served same-origin via Nginx
# (e.g. Nginx serves both the SPA and proxies /api to this backend) — CORS
# isn't needed in that case since the browser never sees a cross-origin call.
FRONTEND_URL=http://102.134.141.78
# PUBLIC_BASE_URL: publicly reachable base URL of this backend (no trailing slash).
# Used for Swagger "Try it out" servers and absolute URLs for locally-stored uploads.
PUBLIC_BASE_URL=http://102.134.141.78
# TRUST_PROXY: set to "1" (one hop, e.g. single Nginx in front) so req.ip reflects
# the real client IP from X-Forwarded-For instead of Nginx's IP. Leave unset for
# local dev without a reverse proxy.
TRUST_PROXY=1

# Mock provider settings
MOCK_PROVIDER_FAILURE_RATE=0.1
MOCK_PROVIDER_DELAY_MS=500
