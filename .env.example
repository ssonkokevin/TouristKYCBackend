# Database & Redis
DATABASE_URL=postgresql://kyc:kyc@localhost:5432/touristkyc
REDIS_URL=redis://localhost:6379

# Server
PORT=3001
JWT_SECRET=replace_me_with_a_long_random_string

# Provider outbound API (placeholder / mock provider)
PROVIDER_BASE_URL=https://provider.example.com/api
PROVIDER_API_KEY=replace_me
PROVIDER_ASSIGN_ENDPOINT=/sim/assign
PROVIDER_TIMEOUT_MS=10000
PROVIDER_MAX_RETRIES=5

# Inbound API key (used by booths / provider calling us)
INBOUND_API_KEY=replace_me

# Business rules
RESERVATION_DEFAULT_HOLD_SECONDS=120
VISA_SUSPEND_LEAD_HOURS=24
DEREGISTER_STALE_DAYS=14

# Storage: local or supabase
STORAGE_PROVIDER=local
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=replace_me
SUPABASE_BUCKET=subscriber-documents

# Mock provider settings
MOCK_PROVIDER_FAILURE_RATE=0.1
MOCK_PROVIDER_DELAY_MS=500
